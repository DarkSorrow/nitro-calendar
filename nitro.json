{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["novasteraoss_nitrocalendar"],
  "ios": {
    "iosModuleName": "NitroCalendar"
  },
  "android": {
    "androidNamespace": ["novasteraoss","nitrocalendar"],
    "androidCxxLibName": "novasteraoss_nitrocalendar"
  },
  "autolinking": {
    "NitroCalendar": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroCalendar"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroCalendar"
      }
    },
    "NitroWheelPickerView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNitroWheelPickerView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroWheelPickerView"
      }
    }
  },
  "ignorePaths": ["node_modules"]
}
